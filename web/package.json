{
  "name": "jobflow-web",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "set JOBFLOW_DEV=1 && electron .",
    "electron:build": "vite build && electron-builder --win"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "electron": "^43.4.0",
    "element-plus": "^2.14.4",
    "pinia": "^4.0.3",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5"
  },
  "build": {
    "appId": "com.jobflow.desktop",
    "productName": "JobFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
